{
  "description": "gabo checks: before Codex applies a patch or runs a shell command, gabo check --pre-write or --pre-command judges the call and can deny it; after a patch, gabo check runs and its failures come back as additional context.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/scripts/gabo-pre-write.sh\" codex"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/scripts/gabo-pre-command.sh\" codex"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/scripts/gabo-check.sh\" codex"
          }
        ]
      }
    ]
  }
}
