{
  "description": "gabo checks: before Claude writes or edits a gabo file, gabo check --pre-write blocks a write that breaks the stage gate; after it, gabo check runs (both off with the checks option).",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/gabo-pre-write.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/gabo-check.sh\""
          }
        ]
      }
    ]
  }
}
