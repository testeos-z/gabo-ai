{{define "packages" -}}
# step: packages
set -eu
missing=""
command -v git >/dev/null 2>&1 || missing="$missing git"
if [ -n "$missing" ]; then
  export DEBIAN_FRONTEND=noninteractive
  apt-get update
  apt-get install -y --no-install-recommends $missing
fi
{{end}}

{{define "user" -}}
# step: user
set -eu
# Single-user mode: the agent sessions and the review all run as this user.
id -u {{q .Orca.Name}} >/dev/null 2>&1 || { echo {{q .Orca.Name}}' user is missing' >&2; exit 1; }
{{end}}

{{define "config" -}}
# step: config
set -eu
install -d -o root -g root -m 755 /etc/gbai
tmp=$(mktemp {{q .ConfigPath}}.XXXXXX)
trap 'rm -f "$tmp"' EXIT
printf %s {{q .ConfigBase64}} | base64 -d > "$tmp"
chown root:root "$tmp"
chmod 644 "$tmp"
mv -f "$tmp" {{q .ConfigPath}}
trap - EXIT
{{end}}

{{define "binary" -}}
# step: binary
set -eu
install -d -o root -g root -m 755 /usr/local/bin
tmp=$(mktemp {{q .BinaryPath}}.XXXXXX)
trap 'rm -f "$tmp"' EXIT
cat > "$tmp"
[ "$(head -c 4 "$tmp" | od -An -tx1 | tr -d ' \n')" = 7f454c46 ] || { echo 'received binary is not ELF' >&2; exit 1; }
chown root:root "$tmp"
chmod 755 "$tmp"
mv -f "$tmp" {{q .BinaryPath}}
trap - EXIT
{{q .BinaryPath}} version
{{end}}

{{define "legacy" -}}
# step: legacy
set -eu
# Remove the sudo path of the retired three-user reviewer model. The old
# reviewer OS users and their homes are left for the owner to remove.
rm -f{{range .LegacyFiles}} {{q .}}{{end}}
rmdir {{q .LegacyDir}} 2>/dev/null || true
{{end}}

{{define "skills" -}}
# step: skills
set -eu
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
tar -x --no-same-owner --no-same-permissions -C "$tmp" -f -
chmod -R u=rwX,go=rX "$tmp"
# Copy as the orca user so root never writes through paths orca controls.
setpriv --reuid={{q .Orca.Name}} --regid="$(id -g {{q .Orca.Name}})" --init-groups env HOME={{q .Orca.Home}} sh -eu -c '
src=$1; shift
for dest in "$@"; do
  mkdir -p "$dest"
  for d in "$src"/*/; do
    n=$(basename "$d")
    rm -rf "$dest/.$n.gbai-new"
    cp -R "$d" "$dest/.$n.gbai-new"
    rm -rf "$dest/$n"
    mv "$dest/.$n.gbai-new" "$dest/$n"
  done
done' gbai-skills "$tmp" {{range .SkillDirs}}{{q .}} {{end}}
{{end}}
