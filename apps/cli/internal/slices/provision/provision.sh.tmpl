{{define "packages" -}}
# step: packages
set -eu
missing=""
command -v sudo >/dev/null 2>&1 || missing="$missing sudo"
command -v git >/dev/null 2>&1 || missing="$missing git"
if [ -n "$missing" ]; then
  export DEBIAN_FRONTEND=noninteractive
  apt-get update
  apt-get install -y --no-install-recommends $missing
fi
{{end}}

{{define "users" -}}
# step: users
set -eu
id -u {{q .Orca.Name}} >/dev/null 2>&1 || { echo {{q .Orca.Name}}' user is missing' >&2; exit 1; }
{{range .Managed -}}
getent group {{q .Name}} >/dev/null || groupadd --gid {{q .UIDText}} {{q .Name}}
id -u {{q .Name}} >/dev/null 2>&1 || useradd --uid {{q .UIDText}} --gid {{q .Name}} --home-dir {{q .Home}} --no-create-home --shell /bin/bash {{q .Name}}
[ "$(id -u {{q .Name}})" = {{q .UIDText}} ] || { echo {{q .Name}}' has an unexpected uid' >&2; exit 1; }
mkdir -p {{q .Home}}
chown {{q .Name}}:{{q .Name}} {{q .Home}}
chmod 700 {{q .Home}}
{{end -}}
install -d -o {{q .Reviewer.Name}} -g {{q .Reviewer.Name}} -m 700 {{q .WorkDir}}
{{end}}

{{define "config" -}}
# step: config
set -eu
install -d -o root -g root -m 755 /etc/gbai
tmp=$(mktemp {{q .ConfigPath}}.XXXXXX)
trap 'rm -f "$tmp"' EXIT
printf %s {{q .ConfigBase64}} | base64 -d > "$tmp"
chown root:root "$tmp"
chmod 644 "$tmp"
mv -f "$tmp" {{q .ConfigPath}}
trap - EXIT
{{end}}

{{define "binary" -}}
# step: binary
set -eu
install -d -o root -g root -m 755 /usr/local/bin
tmp=$(mktemp {{q .BinaryPath}}.XXXXXX)
trap 'rm -f "$tmp"' EXIT
cat > "$tmp"
[ "$(head -c 4 "$tmp" | od -An -tx1 | tr -d ' \n')" = 7f454c46 ] || { echo 'received binary is not ELF' >&2; exit 1; }
chown root:root "$tmp"
chmod 755 "$tmp"
mv -f "$tmp" {{q .BinaryPath}}
trap - EXIT
{{q .BinaryPath}} version
{{end}}

{{define "wrappers" -}}
# step: wrappers
set -eu
install -d -o root -g root -m 755 /usr/local/libexec/gbai
install_wrapper() {
  tmp=$(mktemp "$1.XXXXXX")
  cat > "$tmp"
  sh -n "$tmp" || { rm -f "$tmp"; exit 1; }
  chown root:root "$tmp"
  chmod 755 "$tmp"
  mv -f "$tmp" "$1"
}
install_wrapper {{q .ReviewRun}} <<'GBAI_WRAPPER_EOF'
#!/bin/sh
set -eu
usage() { echo 'usage: review-run head <pr-number> <40-hex-sha>' >&2; exit 64; }
[ "$#" -eq 3 ] && [ "$1" = head ] || usage
case "$2" in ''|0*|*[!0-9]*) usage ;; esac
case "$3" in *[!0-9a-f]*) usage ;; esac
[ "${#3}" -eq 40 ] || usage
umask 077
cd {{q .Reviewer.Home}}
exec env -i HOME={{q .Reviewer.Home}} USER={{q .Reviewer.Name}} LOGNAME={{q .Reviewer.Name}} PATH={{q .Reviewer.PathText}} {{.BinaryPath}} --config {{.ConfigPath}} review run head "$2" "$3"
GBAI_WRAPPER_EOF
install_wrapper {{q .ReviewCI}} <<'GBAI_WRAPPER_EOF'
#!/bin/sh
set -eu
umask 077
cd {{q .ReviewerCI.Home}}
exec env -i HOME={{q .ReviewerCI.Home}} USER={{q .ReviewerCI.Name}} LOGNAME={{q .ReviewerCI.Name}} PATH={{q .ReviewerCI.PathText}} {{.BinaryPath}} --config {{.ConfigPath}} review ci "$@"
GBAI_WRAPPER_EOF
{{end}}

{{define "sudoers" -}}
# step: sudoers
set -eu
command -v visudo >/dev/null 2>&1 || { echo 'visudo is missing' >&2; exit 1; }
grep -Eq '^[@#]includedir /etc/sudoers.d' /etc/sudoers || { echo 'sudoers does not include /etc/sudoers.d' >&2; exit 1; }
tmp=$(mktemp /etc/sudoers.d/.gbai-reviewer.XXXXXX)
trap 'rm -f "$tmp"' EXIT
cat > "$tmp" <<'GBAI_SUDOERS_EOF'
# Managed by gbai provision.
{{.Orca.Name}} ALL=({{.Reviewer.Name}}) NOPASSWD: {{.ReviewRun}}
{{.Reviewer.Name}} ALL=({{.ReviewerCI.Name}}) NOPASSWD: {{.ReviewCI}}
GBAI_SUDOERS_EOF
chown root:root "$tmp"
chmod 440 "$tmp"
visudo -cf "$tmp"
mv -f "$tmp" {{q .SudoersPath}}
trap - EXIT
{{end}}

{{define "skills" -}}
# step: skills
set -eu
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
tar -x --no-same-owner --no-same-permissions -C "$tmp" -f -
chmod -R u=rwX,go=rX "$tmp"
# Copy as the orca user so root never writes through paths orca controls.
setpriv --reuid={{q .Orca.Name}} --regid="$(id -g {{q .Orca.Name}})" --init-groups env HOME={{q .Orca.Home}} sh -eu -c '
src=$1; shift
for dest in "$@"; do
  mkdir -p "$dest"
  for d in "$src"/*/; do
    n=$(basename "$d")
    rm -rf "$dest/.$n.gbai-new"
    cp -R "$d" "$dest/.$n.gbai-new"
    rm -rf "$dest/$n"
    mv "$dest/.$n.gbai-new" "$dest/$n"
  done
done' gbai-skills "$tmp" {{range .SkillDirs}}{{q .}} {{end}}
{{end}}
