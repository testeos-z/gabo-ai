# gabo-reviewer defaults. Plain KEY=value lines, never executed as shell.
# An environment variable of the same name overrides a line here.
# Repository settings (repo, checks, auto merge, human-only paths, marker,
# placement) come from gabo.yaml on the integration branch, not from here.
# No secrets in this file: tokens go in the private env file
# ${XDG_CONFIG_HOME:-~/.config}/gabo/reviewer.env (mode 600).
REVIEWER_MODE=single-user
# The review engine (claude, codex, pi or opencode) comes from runtimes.reviewer
# in gabo.yaml on the integration branch; set REVIEWER_ENGINE only to override
# it. codex and opencode also need the isolation pass marker of the
# gabo-reviewer-config skill for the installed version.
# Empty: the login of the active gh account (gh api user) is the bot login.
REVIEWER_BOT_LOGIN=
# The gabo binary: name on PATH or absolute path. Runs the
# `gabo check` entries of review.checks and must be at least the version in
# the integration branch's .gabo/VERSION.
REVIEWER_GABO_BIN=gabo
# Package for the upgrade command printed when the binary is too old (TRD 9.4).
REVIEWER_GABO_INSTALL=github.com/testeos-z/gabo-ai/apps/cli/cmd/gabo
REVIEWER_MAX_ATTEMPTS=2
REVIEWER_CHECK_TIMEOUT=1800
REVIEWER_REVIEW_TIMEOUT=900
REVIEWER_HEAD_TIMEOUT=7200
REVIEWER_CLAUDE_MAX_TURNS=40
REVIEWER_DIFF_MAX_BYTES=200000
REVIEWER_MERGE_TRIES=5
REVIEWER_MERGE_DELAY=3
# Days an open PR's pr-<n> worktree may stay unused before prune removes it.
REVIEWER_KEEP_DAYS=7
# Size the Go caches and check-home may reach together before prune trims them (K, M or G).
REVIEWER_CACHE_MAX=2G
