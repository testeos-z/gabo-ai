{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "transit": { "dependsOn": ["^transit"] },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "check-types": { "dependsOn": ["transit"] },
    "lint": { "dependsOn": ["transit"] },
    "test": { "dependsOn": ["transit"] },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
