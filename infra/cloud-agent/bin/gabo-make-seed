#!/usr/bin/env bash
# Builds the repository seed of the image: a bare repository holding only the
# target branch and main of a source git dir (the build context's .git), each
# taken from the local branch or else the origin remote-tracking branch, so a
# fresh clone of the default branch still yields `dev` when the source knows it. No network; the source's git config is not copied.
# Usage: gabo-make-seed <source git dir> <seed dir> <origin url> [branch]
set -euo pipefail

if [ $# -lt 3 ] || [ $# -gt 4 ]; then
  echo "usage: gabo-make-seed <source git dir> <seed dir> <origin url> [branch]" >&2
  exit 2
fi
src="$1" seed="$2" url="$3" branch="${4:-dev}"

git init --quiet --bare "$seed"
# Only the target branch and main, never the builder's other local work.
# A local branch wins over the remote-tracking branch of the same name.
for b in $(printf '%s\n' "$branch" main | sort -u); do
  for ref in "refs/heads/$b" "refs/remotes/origin/$b"; do
    if git -C "$src" -c safe.directory='*' rev-parse --verify --quiet "$ref^{commit}" >/dev/null; then
      git -C "$seed" -c safe.directory='*' fetch --quiet --no-tags "$src" "+$ref:refs/heads/$b"
      break
    fi
  done
done
git -C "$seed" remote add origin "$url"

if git -C "$seed" rev-parse --verify --quiet "refs/heads/$branch" >/dev/null; then
  git -C "$seed" symbolic-ref HEAD "refs/heads/$branch"
else
  echo "gabo-make-seed: the source has no branch ${branch}; the agent fetches it at start" >&2
fi
